    },
    "@expo/config-plugins": {
      "glob": "13.0.6"
    },
    "@expo/metro-config": {
      "glob": "13.0.6"
    },
    "cacache": {
      "glob": "13.0.6"
    },
    "sucrase": {
      "glob": "13.0.6"
    },
    "rimraf@3.0.2": {
      "glob": "7.2.3"
