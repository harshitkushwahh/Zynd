  "allowScripts": {
    "@firebase/util": true,
    "esbuild": true,
    "fsevents": true,
    "protobufjs": true,
    "sharp": true,
    "unrs-resolver": true
  },
  "workspaces": [
    "Web",
    "Admin",
    "Support",
    "Distributor",
    "Mobile",
